# ---------------------------------------------------------------------------
# MoodNews environment variables
# Copy to .env and fill in your own values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- LLM ----------------------------------------------------------------------
# Required for mood rewriting and the LLM fact-check pass. Without it the app
# still runs and serves original articles, but rewriting is unavailable.
LLM_API_KEY=your-api-key-here

# Which client to use: auto (default), anthropic, or openai.
#   auto      infers from LLM_MODEL / LLM_BASE_URL - a claude-* model or
#             Anthropic's host selects the native Anthropic SDK, else OpenAI.
#   anthropic native SDK: schema-enforced JSON and policy-refusal handling.
#   openai    any OpenAI-compatible /chat/completions endpoint.
LLM_PROVIDER=auto

# Model name as the provider expects it.
#   Claude:     claude-opus-5   (also claude-sonnet-5, claude-haiku-4-5)
#   z.ai (GLM): glm-4.6
#   OpenAI:     gpt-4o-mini
#   Gemini:     gemini-2.5-flash
LLM_MODEL=gemini-3.7-flash

# Base URL of the OpenAI-compatible API. Ignored when the Anthropic SDK is used
# (it knows its own endpoint), so leave it as-is when running Claude.
#   z.ai (GLM):  https://api.z.ai/api/paas/v4
#   OpenAI:      https://api.openai.com/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://host.docker.internal:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Request timeout, in seconds, for a single LLM call.
LLM_TIMEOUT_SECONDS=90

# Sampling temperature for the mood-rewriting call (some creative latitude).
# Ignored on Claude: current Claude models removed the sampling parameters, so
# the Anthropic backend does not send them (it uses reasoning effort instead).
LLM_REWRITE_TEMPERATURE=0.7

# Sampling temperature for the fact-checking auditor call. Keep this at 0:
# verification should be as reproducible as the provider allows. Also ignored
# on Claude - see above. The binding fact check is the regex layer, which is
# deterministic on every provider.
LLM_VERIFY_TEMPERATURE=0

# --- Database ---------------------------------------------------------------
# Path to the SQLite file. Under Docker this points at the mounted volume and
# is set by docker-compose.yml; for local dev a relative path is fine.
DB_PATH=moodnews.db

# --- Backend ----------------------------------------------------------------
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fetch news from the RSS feeds on startup when the database is still empty.
FETCH_ON_STARTUP=true

# Target number of articles to keep available, and per-feed cap.
MIN_ARTICLES=10
MAX_ARTICLES_PER_FEED=5

# Verbose logging.
DEBUG=false

# --- Frontend ---------------------------------------------------------------
# Where the browser sends API calls. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api. docker-compose overrides this with
# http://backend:8000; use http://localhost:8000 for local dev.
VITE_API_PROXY_TARGET=http://localhost:8000
