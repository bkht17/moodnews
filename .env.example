# ---------------------------------------------------------------------------
# MoodNews environment variables
# Copy to .env and fill in your own values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- LLM: any OpenAI-compatible /chat/completions endpoint --------------------
# Required for mood rewriting and the LLM fact-check pass. Without it the app
# still runs and serves original articles, but rewriting is unavailable.
LLM_API_KEY=your-api-key-here

# Base URL of the OpenAI-compatible API.
#   z.ai (GLM):  https://api.z.ai/api/paas/v4
#   OpenAI:      https://api.openai.com/v1
LLM_BASE_URL=https://api.z.ai/api/paas/v4

# Model name as expected by the endpoint above (e.g. glm-4.6, gpt-4o-mini).
LLM_MODEL=glm-4.6

# Request timeout, in seconds, for a single LLM call.
LLM_TIMEOUT_SECONDS=90

# Sampling temperature for the mood-rewriting call (some creative latitude).
LLM_REWRITE_TEMPERATURE=0.7

# Sampling temperature for the fact-checking auditor call. Keep this at 0:
# verification must be deterministic.
LLM_VERIFY_TEMPERATURE=0

# --- Database ---------------------------------------------------------------
# Path to the SQLite file. Under Docker this points at the mounted volume and
# is set by docker-compose.yml; for local dev a relative path is fine.
DB_PATH=moodnews.db

# --- Backend ----------------------------------------------------------------
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fetch news from the RSS feeds on startup when the database is still empty.
FETCH_ON_STARTUP=true

# Target number of articles to keep available, and per-feed cap.
MIN_ARTICLES=10
MAX_ARTICLES_PER_FEED=5

# Verbose logging.
DEBUG=false

# --- Frontend ---------------------------------------------------------------
# Where the browser sends API calls. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api. docker-compose overrides this with
# http://backend:8000; use http://localhost:8000 for local dev.
VITE_API_PROXY_TARGET=http://localhost:8000
